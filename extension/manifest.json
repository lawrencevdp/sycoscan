{
  "manifest_version": 3,
  "name": "SycoScan",
  "version": "0.1.0",
  "description": "Tags AI replies that may be sycophantic and shows the evidence.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8000/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*"],
    "js": ["content.js"], "css": ["tag.css"]
  }]
}
